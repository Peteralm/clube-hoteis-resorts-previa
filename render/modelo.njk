{%- endif %}
  <title>{{ t.seo.titulo }}</title>
  <meta name="description" content="{{ t.seo.descricao }}">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta name="theme-color" content="#ffffff">
  <!-- DOMINIO-A-DEFINIR: trocar nas 6 ocorrências deste head (canonical, og:url, og:image, twitter:image, JSON-LD x2) e em robots.txt / sitemap.xml -->
  <link rel="canonical" href="https://DOMINIO-A-DEFINIR/">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Clube de Negócios Hotéis &amp; Resorts">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:url" content="https://DOMINIO-A-DEFINIR/">
  <meta property="og:title" content="{{ t.seo.titulo }}">
  <meta property="og:description" content="{{ t.seo.descricao }}">
  <meta property="og:image" content="https://DOMINIO-A-DEFINIR/{{ seo_imagem }}">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ t.seo.imagem_alt }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ t.seo.titulo }}">
  <meta name="twitter:description" content="{{ t.seo.descricao }}">
  <meta name="twitter:image" content="https://DOMINIO-A-DEFINIR/{{ seo_imagem }}">
  <meta name="twitter:image:alt" content="{{ t.seo.imagem_alt }}">

  <link rel="icon" href="favicon.ico" sizes="32x32">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <link rel="manifest" href="site.webmanifest">

  <link rel="preload" as="font" href="../assets/fonts/proza-libre-medium.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="../assets/fonts/proza-libre-regular.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="image" href="assets/cena/mobile-780.webp" imagesrcset="assets/cena/mobile-780.webp 780w, assets/cena/mobile-1170.webp 1170w" imagesizes="100vw" media="not all and (min-width: 900px) and (min-aspect-ratio: 1/1)" fetchpriority="high">
  <link rel="preload" as="image" href="assets/cena/desktop-1600.webp" imagesrcset="assets/cena/desktop-1600.webp 1600w, assets/cena/desktop-2560.webp 2560w" imagesizes="100vw" media="(min-width: 900px) and (min-aspect-ratio: 1/1)" fetchpriority="high">
  <!-- profundidade e máscara da cena (só o WebGL do hero.js usa: sem movimento reduzido), no mesmo enquadramento da foto
       acima. as="fetch" + crossorigin casa com o fetch() do hero.js, que decodifica fora da thread principal -->
  <link rel="preload" as="fetch" href="assets/cena/mobile-prof.webp" crossorigin media="(prefers-reduced-motion: no-preference) and (not ((min-width: 900px) and (min-aspect-ratio: 1/1)))">
  <link rel="preload" as="fetch" href="assets/cena/mobile-mascara.webp" crossorigin media="(prefers-reduced-motion: no-preference) and (not ((min-width: 900px) and (min-aspect-ratio: 1/1)))">
  <link rel="preload" as="fetch" href="assets/cena/desktop-prof.webp" crossorigin media="(prefers-reduced-motion: no-preference) and (min-width: 900px) and (min-aspect-ratio: 1/1)">
  <link rel="preload" as="fetch" href="assets/cena/desktop-mascara.webp" crossorigin media="(prefers-reduced-motion: no-preference) and (min-width: 900px) and (min-aspect-ratio: 1/1)">
  <link rel="stylesheet" href="novo.css?v={{ v }}">
  <link rel="stylesheet" href="secoes.css?v={{ v }}">
  <link rel="stylesheet" href="lead.css?v={{ v }}">
