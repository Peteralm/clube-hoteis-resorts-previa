{#- Modelo da landing page (Nunjucks). renderizar.mjs + conteudo/edicao.json -> index.html (tools/render/gerar.mjs).
    Não edite index.html à mão: edite este modelo (estrutura, classes, animação) ou o JSON (textos, datas, fotos).
    Variáveis: d = dados com HTML escapado; cru = dados puros; dias = os dias com as datas já calculadas;
    img(valor, larguras, src) / video(valor) resolvem caminhos locais e "midia:". Filtros: enfase (*x* -> <em>x</em>),
    sem_enfase, linhas (quebra por linha). Marcadores do editor: campo(caminho), campo_img(caminho), lista(caminho),
    item(i), painel(nome) devolvem "" fora do modo edição. Atenção (Nunjucks != Jinja): lista vazia é verdadeira em
    if (use |length) e não há índice negativo (use |last). -#}
{%- set t = d.textos -%}
{%- set pal = d.palestrantes -%}
{%- set ing = d.ingressos -%}
{%- set whats = "https://wa.me/5511919259667?text=Ol%C3%A1%21%20Quero%20garantir%20meu%20acesso%20ao%20Clube%20de%20Neg%C3%B3cios%20de%20Hot%C3%A9is%20%26%20Resorts." -%}
{%- set seta = '<span class="botao__seta" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>' -%}
{%- set desce = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 5v13m-5-5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>' -%}
{%- set pino = '<svg class="mapa__nome-icone" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>' -%}
{#- retratos com recorte próprio em secoes.css (.retrato--<id>); outro código ganha um quadro genérico, com a foto
    cobrindo o quadro e sem recorte -#}
{%- set RECORTE = ["enio", "nezio", "pablo"] -%}
{%- macro sem_recorte(id, proporcao) %}{% if id not in RECORTE %} style="aspect-ratio: {{ proporcao }}"{% endif %}{% endmacro -%}
{%- macro foto_sem_recorte(id, foto) %}{% if id not in RECORTE %} style="inset: 0; width: 100%; height: 100%; object-fit: cover; transform: none{{ "; " ~ foco(foto) if foco(foto) else "" }}"{% else %}{{ estilo(foco(foto)) }}{% endif %}{% endmacro -%}
{%- macro quadro(c, alvo, largura) -%}
{%- set f = img(cru.textos.oque[c].foto, largura[0], largura[1]) -%}
<div class="oque__foto"><img{{ campo_img("textos.oque." ~ c ~ ".foto") }} src="{{ f.src }}"{% if f.srcset %} srcset="{{ f.srcset }}" sizes="(min-width: 900px) 62vw, 100vw"{% endif %} alt="{{ t.oque[c].foto_alt }}" width="{{ f.w }}" height="{{ f.h }}"{{ estilo(foco(cru.textos.oque[c].foto)) }} loading="lazy" decoding="async"></div>
{%- endmacro -%}
<!doctype html>
<html lang="pt-BR" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{%- if not edicao %}
  <!-- Rastreamento do tráfego pago, o mesmo do site do Ênio (pedido do cliente): Tag Manager, Pixel da Meta e tag do Google
       (GA4 do Site Kit). Só no domínio oficial: a prévia do GitHub e o painel não contam visitas nem conversões.
       Os eventos de conversão saem de lead.js (InitiateCheckout ao abrir o cadastro, Lead quando ele chega ao Clint). -->
  <script>
    if (/(^|\.)enioalmeida\.com\.br$/.test(location.hostname)) {
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-583MRBGS');
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)
      }(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1867167943856509');
      fbq('track', 'PageView');
      window.gtag = function(){dataLayer.push(arguments);};
      (function(d){var t=d.createElement('script');t.async=true;t.src='https://www.googletagmanager.com/gtag/js?id=GT-PHXZX6M7';d.head.appendChild(t);})(document);
      gtag('js', new Date());
      gtag('set', 'linker', {domains: ['enioalmeida.com.br']});
      gtag('config', 'GT-PHXZX6M7');
